generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


// Example User model - customize based on your needs
// Example User model - customize based on your needs
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  role      Role     @default(STUDENT)
  password  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

